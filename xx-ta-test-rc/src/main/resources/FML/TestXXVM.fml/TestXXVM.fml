use org.openflexo.ta.xx.XXModelSlot as XX;

import org.openflexo.ta.xx.model.XXText;
import org.openflexo.ta.xx.model.XXLine;

/**
 * Template VirtualModel of the XX technology adapter: a model slot on an XX text, and a concept playing one of its lines.
 * Exercised by AutomatedTests/TestXXVM.fmlscript.
 */
@URI("http://www.openflexo.org/test/xx/FML/TestXXVM.fml")
@Version("0.1")
public model TestXXVM {

	public XXText text with XXModelSlot();

	create(required Resource<XXText> resource) {
		connect text using parameters.resource;
	}

	public concept Line {
		public XXLine line with XXLineRole();
		create() {
		}
		delete() {
		}
	}
}
